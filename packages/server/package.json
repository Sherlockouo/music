    "@fastify/sensible": "^4.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.15.0",
    "@neteasecloudmusicapienhanced/api": "^4.31.0",
    "@unblockneteasemusic/server": "^0.27.10",
    "axios": "^0.27.2",
    "better-sqlite3": "9.2.2",
    "change-case": "^4.1.2",
    "compare-versions": "^4.1.4",
    "fastify": "^4.29.1",
    "fastify-cli": "^4.4.0",
